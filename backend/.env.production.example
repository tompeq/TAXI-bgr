NODE_ENV=production
PORT=3000
API_PORT=3000
ADMIN_PORT=8080
BUSINESS_TIME_ZONE=Asia/Vladivostok

# Replace SERVER_IP with the actual public IPv4 address.
CORS_ORIGINS=http://SERVER_IP:8080
TRUSTED_PROXY_CIDRS=

DB_HOST=postgres
DB_PORT=5432
DB_NAME=taxi_bgr
DB_USER=taxi_bgr
DB_PASSWORD=replace-with-a-long-random-password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

REDIS_URL=redis://redis:6379
ORDER_COMPLETION_RADIUS_METERS=300

S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
# Public proxy for temporary document links. MinIO itself remains private.
S3_PUBLIC_BASE_URL=http://SERVER_IP:8080/storage
S3_ACCESS_KEY=replace-with-a-minio-access-key
S3_SECRET_KEY=replace-with-a-long-random-minio-secret
S3_BUCKET=taxi-bgr-documents

SMS_MODE=smspilot
SMSPILOT_API_KEY=replace-with-the-64-character-api-key
SMSPILOT_SENDER=

OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REGISTRATION_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REGISTRATION_TOKEN_TTL_SECONDS=1800
REGISTRATION_UPLOAD_RETENTION_HOURS=24
REFRESH_TOKEN_TTL_DAYS=30

# Set the real Firebase service-account value to enable push notifications.
FCM_SERVICE_ACCOUNT_BASE64=

# Used only while building the admin image.
ADMIN_API_URL=http://SERVER_IP:3000/api/v1
