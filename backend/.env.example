NODE_ENV=development
PORT=3000
API_PORT=3000
BUSINESS_TIME_ZONE=Asia/Vladivostok
CORS_ORIGINS=http://localhost:5173
# Leave empty for a direct deployment. Set reverse-proxy IPs/CIDRs only when one is used.
TRUSTED_PROXY_CIDRS=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=taxi_bgr
DB_USER=taxi_bgr
DB_PASSWORD=taxi_bgr_dev
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

REDIS_URL=redis://localhost:6379
ORDER_COMPLETION_RADIUS_METERS=300

S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=taxi_bgr_minio
S3_SECRET_KEY=taxi_bgr_minio_dev_secret
S3_BUCKET=taxi-bgr-documents

SMS_MODE=mock
# Set SMS_MODE=smspilot and add the key only to your local .env file.
SMSPILOT_API_KEY=
# Leave empty to use SMSPILOT's shared sender without a monthly fee.
SMSPILOT_SENDER=
OTP_HASH_SECRET=dev-otp-secret-change-me-32-characters
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5

JWT_ACCESS_SECRET=dev-access-secret-change-me-32-characters
JWT_REGISTRATION_SECRET=dev-registration-secret-change-me-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REGISTRATION_TOKEN_TTL_SECONDS=1800
# Incomplete registration uploads with no database reference are deleted after this time.
REGISTRATION_UPLOAD_RETENTION_HOURS=24
REFRESH_TOKEN_TTL_DAYS=30

# Base64-encoded Firebase service account JSON. Leave empty to disable push.
FCM_SERVICE_ACCOUNT_BASE64=
